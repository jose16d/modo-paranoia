# Cabeceras HTTP de Cloudflare Pages.
#
# Este archivo no se sirve: Pages lo lee al desplegar y lo aplica a las respuestas.
# Las reglas se evalúan de la más general a la más específica.

/*
  # Impide que el navegador adivine el tipo de un archivo y lo ejecute como otra cosa
  X-Content-Type-Options: nosniff
  # El sitio no se puede incrustar en un iframe ajeno
  X-Frame-Options: DENY
  # Al salir hacia otro dominio solo se envía el origen, nunca la URL completa
  Referrer-Policy: strict-origin-when-cross-origin
  # Un medio de análisis crítico no necesita cámara, micrófono ni ubicación
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=()
  #
  # CSP: el sitio es estático y no carga nada de terceros. `unsafe-inline` en estilos
  # es necesario porque Astro incrusta las hojas pequeñas en el HTML; los scripts NO
  # lo llevan, así que un script inyectado no se ejecuta.
  #
  # No hay ninguna excepción para un panel de edición: la Fase 6 (Sveltia CMS en
  # /admin, con un Worker de OAuth) se descartó el 5 de septiembre de 2026 y no se
  # monta. Si algún día se retoma, la regla va específica para `/admin/*` y NO se
  # afloja esta.
  # `form-action` incluye app.kit.com porque el formulario de El Correo envía ahí
  # con un POST nativo del navegador. Se ensancha **solo esa** directiva: el
  # embebido con JavaScript de Kit habría obligado a tocar `script-src`, y meter
  # JavaScript de terceros en la portada cuesta el TBT de 0 ms que sostiene toda
  # la elección de stack. Ver src/components/SuscripcionCorreo.astro.
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self' https://app.kit.com; frame-ancestors 'none'

# Astro pone una huella en el nombre de cada recurso compilado: si cambia el
# contenido, cambia el nombre. Por eso se pueden cachear para siempre.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# EXPERIMENTO (13 sep 2026): `no-transform` en las páginas que Cloudflare reescribe.
#
# Cloudflare modifica el HTML en su borde sin que el sitio lo pida. En `/contacto`,
# `/cookies` y `/privacidad` su ofuscación de correos cambia cada dirección por
# «[email protected]» y la recupera con un script, así que sin JavaScript la dirección
# para ejercer los derechos no se ve. Y en todas las páginas inyecta el script de
# JavaScript Detections, que la CSP bloquea (ver docs/adr/0004).
#
# Su documentación dice que con `Cache-Control: no-transform` no hace ninguna de las dos
# cosas. Lo que no dice es si una cabecera de este archivo cuenta como «la del origen», y
# advierte que la directiva **también puede apagar la compresión Brotli**. Por eso va
# acotado: las tres páginas con correos y la portada, que sirve de prueba para el script.
#
# El valor repite el que Pages pone por defecto al HTML (`public, max-age=0,
# must-revalidate`) porque una cabecera de este archivo **sustituye** a la de Pages: sin
# repetirlo, las páginas perderían la revalidación y el navegador podría servirlas viejas.
#
# Se queda solo si, en producción, las cuatro páginas siguen con `Content-Encoding: br`
# y la ofuscación desaparece. Si se pierde la compresión, se revierte.
/
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/contacto
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/cookies
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/privacidad
  Cache-Control: public, max-age=0, must-revalidate, no-transform
