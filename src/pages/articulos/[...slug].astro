---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icono from '../../components/Icono.astro';
import SuscripcionCorreo from '../../components/SuscripcionCorreo.astro';
import {
  obtenerArticulos,
  formatearFecha,
  formatearFechaCorta,
  minutosDeLectura,
} from '../../lib/articulos';
import { SECCIONES, SITIO } from '../../lib/secciones';
import { aClave } from '../../lib/etiquetas';

export async function getStaticPaths() {
  const articulos = await obtenerArticulos();
  return articulos.map((articulo, indice) => ({
    params: { slug: articulo.id },
    props: {
      articulo,
      /*
       * Los artículos vienen ordenados por fecha descendente (del más nuevo al más viejo).
       * El artículo cronológicamente posterior (más reciente) está en `indice - 1`.
       * El artículo cronológicamente anterior (más antiguo) está en `indice + 1`.
       */
      siguiente: articulos[indice - 1] ?? null,
      anterior: articulos[indice + 1] ?? null,
    },
  }));
}

const { articulo, anterior, siguiente } = Astro.props;
const { Content } = await render(articulo);
const seccion = SECCIONES[articulo.data.seccion];
const minutos = minutosDeLectura(articulo.body ?? '');
---

<Base
  titulo={articulo.data.titulo}
  descripcion={articulo.data.bajada}
  esArticulo
  publicado={articulo.data.fecha}
  actualizado={articulo.data.actualizado}
  autor={articulo.data.autor}
  imagen={`/og/${articulo.id}.png`}
  imagenAlt={`${articulo.data.titulo} — ${seccion.nombre} en ${SITIO.nombre}`}
>
  <article class="contenedor" style={`--acento: var(${seccion.color})`}>
    <header class="encabezado">
      <a class="etiqueta" href={`/seccion/${articulo.data.seccion}`}>
        <Icono nombre={articulo.data.seccion} familia="secciones" tam="0.95em" />
        {seccion.nombre}
      </a>

      <h1>{articulo.data.titulo}</h1>
      <p class="bajada medida">{articulo.data.bajada}</p>

      <p class="mono meta">
        <span class="dato">
          <Icono nombre="calendario" tam="0.95em" />
          <time datetime={articulo.data.fecha.toISOString()}>
            {formatearFecha(articulo.data.fecha)}
          </time>
        </span>
        <span class="dato">
          <Icono nombre="reloj" tam="0.95em" />
          {minutos} min de lectura
        </span>
        <span class="dato">
          <Icono nombre="autor" tam="0.95em" />
          <a href="/quien-escribe">Jose</a>
        </span>
      </p>

      {
        articulo.data.borrador && (
          <p class="aviso">
            <Icono nombre="alerta" tam="1.05em" />
            <span>
              Borrador. Esta pieza no se publica en producción hasta que <code>borrador</code>{' '}
              sea <code>false</code>.
            </span>
          </p>
        )
      }
    </header>

    <div class="prosa">
      <Content />
    </div>

    <section class="tarjeta correo-articulo">
      <h2>
        <Icono nombre="el-correo" familia="secciones" tam="0.95em" />
        El Correo
      </h2>
      <p class="medida">
        Tres cosas que pasaron esta semana, una que importa, y por qué. Cuatro minutos de
        lectura, los sábados. Sin relleno.
      </p>
      <SuscripcionCorreo />
    </section>

    {
      articulo.data.fuentes.length > 0 && (
        <section class="bloque">
          <h2 class="mono rotulo">
            <Icono nombre="lupa-documento" tam="1.15em" />
            Fuentes
          </h2>
          <ol class="fuentes">
            {articulo.data.fuentes.map((f) => (
              <li>
                <a href={f.url} rel="noopener nofollow" target="_blank">
                  {f.titulo}
                  <Icono nombre="enlace-externo" tam="0.85em" etiqueta="Se abre en una pestaña nueva" />
                </a>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {
      articulo.data.etiquetas.length > 0 && (
        <p class="mono etiquetas">
          <Icono nombre="etiqueta" tam="1em" />
          {articulo.data.etiquetas.map((e) => (
            <a href={`/etiqueta/${aClave(e)}`}>#{e}</a>
          ))}
        </p>
      )
    }

    {
      (anterior || siguiente) && (
        <nav class="navegacion-articulos" aria-label="Artículos adyacentes">
          {anterior ? (
            <a class="tarjeta enlace-articulo enlace-articulo--anterior" href={`/articulos/${anterior.id}`}>
              <span class="mono sentido">
                <Icono nombre="flecha-izquierda" tam="0.95em" />
                Artículo anterior
              </span>
              <strong class="titulo-adyacente">{anterior.data.titulo}</strong>
              <span class="mono fecha-adyacente">{formatearFechaCorta(anterior.data.fecha)}</span>
            </a>
          ) : (
            <div class="tarjeta enlace-articulo enlace-articulo--vacio" aria-hidden="true" />
          )}

          {siguiente ? (
            <a class="tarjeta enlace-articulo enlace-articulo--siguiente" href={`/articulos/${siguiente.id}`}>
              <span class="mono sentido">
                Artículo siguiente
                <Icono nombre="flecha-derecha" tam="0.95em" />
              </span>
              <strong class="titulo-adyacente">{siguiente.data.titulo}</strong>
              <span class="mono fecha-adyacente">{formatearFechaCorta(siguiente.data.fecha)}</span>
            </a>
          ) : (
            <div class="tarjeta enlace-articulo enlace-articulo--vacio" aria-hidden="true" />
          )}
        </nav>
      )
    }
  </article>
</Base>

<style>
  .encabezado {
    padding-block: 3rem 2rem;
    border-block-end: 1px solid var(--borde);
    margin-block-end: 2.5rem;
  }

  .encabezado h1 {
    margin-block-start: 1.2rem;
  }

  .bajada {
    font-size: 1.2rem;
    color: var(--texto-2);
    margin-block-start: 1rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.3rem;
    margin-block-start: 1.5rem;
  }

  .dato {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
  }

  .meta a {
    color: var(--texto-2);
  }

  .meta a:hover {
    color: var(--neon);
  }

  .aviso {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    margin-block-start: 1.5rem;
    padding: 0.8rem 1rem;
    border: 1px solid color-mix(in srgb, var(--ambar) 35%, transparent);
    background: color-mix(in srgb, var(--ambar) 10%, transparent);
    border-radius: 8px;
    font-size: 0.9rem;
    color: var(--ambar);
  }

  .bloque {
    max-width: var(--medida);
    margin-block-start: 3rem;
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--borde);
  }

  .rotulo {
    display: flex;
    align-items: center;
    gap: 0.5em;
    margin-block-end: 0.9rem;
  }

  .bloque p {
    color: var(--texto-2);
    font-size: 0.95rem;
  }

  .fuentes {
    padding-inline-start: 1.3rem;
    display: grid;
    gap: 0.5rem;
    font-size: 0.95rem;
  }

  .fuentes a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35em;
  }

  .etiquetas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem;
    margin-block-start: 2.5rem;
  }

  .etiquetas a {
    color: var(--texto-2);
    text-decoration: none;
  }

  .etiquetas a:hover {
    color: var(--neon);
  }

  /* Bloque de suscripción dentro del artículo: captura de lectores calificados */
  .correo-articulo {
    max-width: var(--medida);
    margin-block-start: 3.5rem;
    padding: 2rem;
    border-color: color-mix(in srgb, var(--neon) 35%, var(--borde));
  }

  .correo-articulo h2 {
    display: flex;
    align-items: center;
    gap: 0.45em;
    font-size: 1.45rem;
    color: var(--neon);
  }

  .correo-articulo p {
    color: var(--texto-2);
    margin-block-start: 0.5rem;
    font-size: 0.95rem;
  }

  /* Rejilla de navegación post-lectura (artículo anterior / siguiente) */
  .navegacion-articulos {
    max-width: var(--medida);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.1rem;
    margin-block-start: 3.5rem;
    padding-block-start: 2rem;
    border-block-start: 1px solid var(--borde);
  }

  .enlace-articulo {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 1.2rem;
  }

  .enlace-articulo:hover {
    border-color: var(--neon);
  }

  .enlace-articulo--siguiente {
    text-align: right;
  }

  .enlace-articulo--siguiente .sentido {
    justify-content: flex-end;
  }

  .sentido {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-size: 0.72rem;
    color: var(--neon);
  }

  .titulo-adyacente {
    font-family: var(--f-ui);
    font-weight: 700;
    font-size: 0.95rem;
    line-height: 1.3;
    color: var(--texto);
    flex: 1;
  }

  .enlace-articulo:hover .titulo-adyacente {
    color: var(--neon);
  }

  .fecha-adyacente {
    font-size: 0.72rem;
    color: var(--texto-2);
  }

  .enlace-articulo--vacio {
    visibility: hidden;
    padding: 0;
    border: none;
  }

  @media (max-width: 580px) {
    .enlace-articulo--vacio {
      display: none;
    }

    .enlace-articulo--siguiente {
      text-align: left;
    }

    .enlace-articulo--siguiente .sentido {
      justify-content: flex-start;
    }
  }
</style>
