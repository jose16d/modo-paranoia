---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { obtenerArticulos, formatearFecha, minutosDeLectura } from '../../lib/articulos';
import { SECCIONES } from '../../lib/secciones';

export async function getStaticPaths() {
  const articulos = await obtenerArticulos();
  return articulos.map((articulo) => ({
    params: { slug: articulo.id },
    props: { articulo },
  }));
}

const { articulo } = Astro.props;
const { Content } = await render(articulo);
const seccion = SECCIONES[articulo.data.seccion];
const minutos = minutosDeLectura(articulo.body ?? '');
---

<Base
  titulo={articulo.data.titulo}
  descripcion={articulo.data.bajada}
  esArticulo
  publicado={articulo.data.fecha}
  actualizado={articulo.data.actualizado}
>
  <article class="contenedor" style={`--acento: var(${seccion.color})`}>
    <header class="encabezado">
      <a class="etiqueta" href={`/seccion/${articulo.data.seccion}`}>{seccion.nombre}</a>

      <h1>{articulo.data.titulo}</h1>
      <p class="bajada medida">{articulo.data.bajada}</p>

      <p class="mono meta">
        <time datetime={articulo.data.fecha.toISOString()}>
          {formatearFecha(articulo.data.fecha)}
        </time>
        <span aria-hidden="true">·</span>
        <span>{minutos} min de lectura</span>
        <span aria-hidden="true">·</span>
        <a href="/quien-escribe">Jose</a>
      </p>

      {
        articulo.data.borrador && (
          <p class="aviso">
            Borrador. Esta pieza no se publica en producción hasta que
            <code>borrador</code> sea <code>false</code>.
          </p>
        )
      }
    </header>

    <div class="prosa">
      <Content />
    </div>

    {
      articulo.data.usoIA && (
        <aside class="bloque">
          <h2 class="mono rotulo">Cómo usé IA en esta pieza</h2>
          <p>{articulo.data.usoIA}</p>
        </aside>
      )
    }

    {
      articulo.data.fuentes.length > 0 && (
        <section class="bloque">
          <h2 class="mono rotulo">Fuentes</h2>
          <ol class="fuentes">
            {articulo.data.fuentes.map((f) => (
              <li>
                <a href={f.url} rel="noopener nofollow" target="_blank">
                  {f.titulo}
                </a>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {
      articulo.data.etiquetas.length > 0 && (
        <p class="mono etiquetas">
          {articulo.data.etiquetas.map((e) => (
            <span>#{e}</span>
          ))}
        </p>
      )
    }
  </article>
</Base>

<style>
  .encabezado {
    padding-block: 3rem 2rem;
    border-block-end: 1px solid var(--borde);
    margin-block-end: 2.5rem;
  }

  .encabezado h1 {
    margin-block-start: 1.2rem;
  }

  .bajada {
    font-size: 1.2rem;
    color: var(--texto-2);
    margin-block-start: 1rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block-start: 1.5rem;
  }

  .meta a {
    color: var(--texto-2);
  }

  .meta a:hover {
    color: var(--neon);
  }

  .aviso {
    margin-block-start: 1.5rem;
    padding: 0.8rem 1rem;
    border: 1px solid color-mix(in srgb, var(--ambar) 35%, transparent);
    background: color-mix(in srgb, var(--ambar) 10%, transparent);
    border-radius: 8px;
    font-size: 0.9rem;
    color: var(--ambar);
  }

  .bloque {
    max-width: var(--medida);
    margin-block-start: 3rem;
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--borde);
  }

  .rotulo {
    margin-block-end: 0.9rem;
  }

  .bloque p {
    color: var(--texto-2);
    font-size: 0.95rem;
  }

  .fuentes {
    padding-inline-start: 1.3rem;
    display: grid;
    gap: 0.5rem;
    font-size: 0.95rem;
  }

  .etiquetas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-block-start: 2.5rem;
  }
</style>
