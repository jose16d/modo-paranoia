---
/**
 * Archivo: todas las piezas publicadas, agrupadas por año.
 *
 * Existe porque la portada enseña solo las siete más recientes y, hasta el 13 sep 2026,
 * `/articulos` daba 404 aunque cada pieza viviera en `/articulos/{id}`.
 *
 * **Una sola página, sin paginar, a propósito.** Con un ensayo por semana son unas 48
 * piezas al año, y una línea por pieza se lee bien durante años. Paginar aquí además
 * chocaría con la ruta de cada artículo: `src/pages/articulos/[...slug].astro` es un
 * parámetro de resto, y `/articulos/2` sería a la vez la página 2 y un artículo llamado «2».
 * Si algún día hace falta, se pagina por año (`/articulos/2027`), no por número.
 *
 * **Lista y no tarjetas:** sin imágenes, así que la página pesa lo mismo con 4 piezas que con
 * 200. Las tarjetas con imagen se quedan en la portada y en las secciones.
 */
import Base from '../../layouts/Base.astro';
import Icono from '../../components/Icono.astro';
import { obtenerArticulos, formatearFechaCorta, type Articulo } from '../../lib/articulos';
import { SECCIONES } from '../../lib/secciones';

const articulos = await obtenerArticulos();

/*
 * El año sale de `getUTCFullYear()` y no de `getFullYear()`: la fecha del front matter es
 * medianoche UTC (nota 5 de las notas técnicas, ADR-0002), y en zona local una pieza del
 * 1 de enero caería en el año anterior. `obtenerArticulos()` ya las da ordenadas de la más
 * reciente a la más antigua, y el `Map` conserva ese orden al agrupar.
 */
const porAnio = new Map<number, Articulo[]>();
for (const articulo of articulos) {
  const anio = articulo.data.fecha.getUTCFullYear();
  porAnio.set(anio, [...(porAnio.get(anio) ?? []), articulo]);
}

const total = articulos.length;
const piezas = (n: number) => `${n} ${n === 1 ? 'pieza' : 'piezas'}`;
---

<Base
  titulo="Todos los artículos"
  descripcion="Todas las piezas de Modo Paranoia, de la más reciente a la más antigua, agrupadas por año."
>
  <div class="contenedor">
    <header class="encabezado">
      <p class="mono">Archivo · {piezas(total)}</p>
      <h1>
        <Icono nombre="archivo-cajas" tam="0.8em" />
        Todos los artículos
      </h1>
      <p class="entradilla medida">
        Todo lo publicado, de lo más reciente a lo más antiguo. Para buscar por tema están las
        <a href="/etiquetas">etiquetas</a>; por formato, las secciones.
      </p>
    </header>

    {
      total === 0 ? (
        <div class="tarjeta">
          <p>Todavía no hay piezas publicadas.</p>
        </div>
      ) : (
        [...porAnio].map(([anio, lista]) => (
          <section class="anio" aria-labelledby={`anio-${anio}`}>
            <h2 id={`anio-${anio}`} class="anio__titulo">
              {anio}
              <span class="mono cuenta">{piezas(lista.length)}</span>
            </h2>

            <ol class="lista">
              {lista.map((articulo) => {
                const seccion = SECCIONES[articulo.data.seccion];
                return (
                  <li class="pieza" style={`--acento: var(${seccion.color})`}>
                    <time class="mono fecha" datetime={articulo.data.fecha.toISOString()}>
                      {formatearFechaCorta(articulo.data.fecha)}
                    </time>
                    <a class="titulo" href={`/articulos/${articulo.id}`}>
                      {articulo.data.titulo}
                    </a>
                    <a class="mono seccion" href={`/seccion/${articulo.data.seccion}`}>
                      {seccion.nombre}
                    </a>
                  </li>
                );
              })}
            </ol>
          </section>
        ))
      )
    }
  </div>
</Base>

<style>
  .encabezado {
    padding-block: 3.5rem 2rem;
    border-block-end: 1px solid var(--borde);
    margin-block-end: 1rem;
  }

  .encabezado h1 {
    display: flex;
    align-items: center;
    gap: 0.4em;
    margin-block-start: 0.8rem;
  }

  .entradilla {
    margin-block-start: 1rem;
    font-size: 1.1rem;
    color: var(--texto-2);
  }

  .anio {
    max-width: 52rem;
  }

  .anio__titulo {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.3rem 0.9rem;
    font-size: 1.6rem;
    margin-block: 2.5rem 0.4rem;
  }

  .cuenta {
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    color: var(--texto-2);
  }

  .lista {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  /*
   * Dos columnas en pantalla ancha —la fecha a la izquierda, el titular y la sección a la
   * derecha— y una sola en móvil, donde la fecha pasa arriba. La columna de la fecha tiene
   * ancho fijo para que los titulares arranquen todos en la misma vertical.
   */
  .pieza {
    display: grid;
    grid-template-columns: 9.5rem 1fr;
    gap: 0.3rem 1.2rem;
    padding-block: 1rem;
    border-block-end: 1px solid var(--borde);
  }

  .fecha {
    grid-row: span 2;
    padding-block-start: 0.2rem;
    font-size: 0.75rem;
    color: var(--texto-2);
  }

  .titulo {
    font-family: var(--f-ui);
    font-weight: 700;
    font-size: 1.05rem;
    line-height: 1.3;
    color: var(--texto);
    text-decoration: none;
  }

  .titulo:hover {
    color: var(--neon);
  }

  /*
   * El nombre de la sección en su color, como en las tarjetas. Aquí va sobre Ónix y no
   * sobre la píldora de Carbono, así que el rojo de Modo Autopsia sí pasa AA sin la
   * variante aclarada: los ratios medidos están en la descripción del PR.
   */
  .seccion {
    justify-self: start;
    font-size: 0.72rem;
    color: var(--acento);
    text-decoration: none;
  }

  .seccion:hover {
    text-decoration: underline;
  }

  @media (max-width: 479px) {
    .pieza {
      grid-template-columns: 1fr;
    }

    .fecha {
      grid-row: auto;
      padding-block-start: 0;
    }
  }
</style>
