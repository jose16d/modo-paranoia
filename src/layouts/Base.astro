---
/**
 * Capa base de todas las páginas: <head>, fuentes, estilos y metadatos.
 * Ninguna página escribe su propio <html>.
 */
import '@fontsource/syne/latin-700.css';
import '@fontsource/syne/latin-800.css';
import '@fontsource/space-grotesk/latin-400.css';
import '@fontsource/space-grotesk/latin-500.css';
import '@fontsource/space-grotesk/latin-700.css';
import '@fontsource-variable/inter/wght.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-600.css';
import '../styles/global.css';

import CabeceraSitio from '../components/CabeceraSitio.astro';
import PieSitio from '../components/PieSitio.astro';
import { SITIO } from '../lib/secciones';

interface Props {
  titulo: string;
  descripcion?: string;
  /** true en páginas de artículo: cambia el og:type y activa el JSON-LD de Article */
  esArticulo?: boolean;
  publicado?: Date;
  actualizado?: Date;
  /** Evita indexar páginas utilitarias como el 404 */
  noIndexar?: boolean;
  /** Ruta absoluta del sitio, p. ej. `/og.png`. Sin ella se usa la imagen de marca. */
  imagen?: string;
}

const {
  titulo,
  descripcion = SITIO.descripcion,
  esArticulo = false,
  publicado,
  actualizado,
  noIndexar = false,
  imagen = '/og.png',
} = Astro.props;

const tituloCompleto = titulo === SITIO.nombre ? titulo : `${titulo} · ${SITIO.nombre}`;
const base = Astro.site ?? SITIO.url;

/**
 * Con `build.format: 'file'`, al compilar `Astro.url.pathname` termina en `.html`
 * (`/contacto.html`, `/index.html`), pero Cloudflare Pages sirve esas páginas en
 * `/contacto` y `/`, que es lo que apuntan todos los enlaces internos. Sin esta
 * normalización, la canónica declararía una dirección distinta de la enlazada y
 * partiría en dos la señal que recibe Google.
 */
function rutaCanonica(ruta: string): string {
  if (ruta === '/index.html') return '/';
  return ruta.replace(/\.html$/, '');
}

const canonica = new URL(rutaCanonica(Astro.url.pathname), base).href;
// Las redes sociales exigen URL absoluta en og:image; una ruta relativa se ignora.
const imagenAbsoluta = new URL(imagen, base).href;

const jsonLd = esArticulo
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: titulo,
      description: descripcion,
      datePublished: publicado?.toISOString(),
      dateModified: (actualizado ?? publicado)?.toISOString(),
      inLanguage: 'es',
      mainEntityOfPage: canonica,
      author: { '@type': 'Person', name: 'Jose', url: `${SITIO.url}/quien-escribe` },
      publisher: { '@type': 'Organization', name: SITIO.nombre, url: SITIO.url },
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: SITIO.nombre,
      description: SITIO.descripcion,
      url: SITIO.url,
      inLanguage: 'es',
    };
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    {noIndexar && <meta name="robots" content="noindex" />}

    {/* El .ico es solo para navegadores viejos; los actuales prefieren el SVG. */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={SITIO.nombre} href="/rss.xml" />
    <meta name="theme-color" content="#0D0E12" />

    <meta property="og:type" content={esArticulo ? 'article' : 'website'} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:site_name" content={SITIO.nombre} />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:image" content={imagenAbsoluta} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITIO.nombre} — ${SITIO.eslogan}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={imagenAbsoluta} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>

  <body>
    <a href="#contenido" class="saltar">Saltar al contenido</a>
    <CabeceraSitio />
    <main id="contenido">
      <slot />
    </main>
    <PieSitio />
  </body>
</html>

<style>
  .saltar {
    /* fixed y no absolute: así el enlace también funciona con la página desplazada */
    position: fixed;
    inset-block-start: -3rem;
    inset-inline-start: 1rem;
    z-index: 50;
    background: var(--neon);
    color: var(--onix);
    padding: 0.6rem 1rem;
    border-radius: 0 0 8px 8px;
    font-family: var(--f-ui);
    font-weight: 700;
    text-decoration: none;
    transition: inset-block-start 0.15s ease;
  }

  .saltar:focus {
    inset-block-start: 0;
  }

  main {
    flex: 1;
  }
</style>
