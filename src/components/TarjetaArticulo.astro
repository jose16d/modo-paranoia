---
import type { CollectionEntry } from 'astro:content';
import Icono from './Icono.astro';
import { SECCIONES } from '../lib/secciones';
import { formatearFechaCorta } from '../lib/articulos';

interface Props {
  articulo: CollectionEntry<'articulos'>;
  /** La pieza destacada de la portada se muestra más grande */
  grande?: boolean;
}

const { articulo, grande = false } = Astro.props;
const seccion = SECCIONES[articulo.data.seccion];

const fecha = formatearFechaCorta(articulo.data.fecha);
---

<article class:list={['tarjeta', { 'tarjeta--grande': grande }]} style={`--acento: var(${seccion.color})`}>
  <div class="cabecera-tarjeta">
    <span class="etiqueta">
      <Icono nombre={articulo.data.seccion} familia="secciones" tam="0.95em" />
      {seccion.nombre}
    </span>
    {grande && <span class="mono kicker">Último ensayo</span>}
  </div>

  <h3 class="titulo">
    <a href={`/articulos/${articulo.id}`}>{articulo.data.titulo}</a>
  </h3>

  <p class="bajada">{articulo.data.bajada}</p>

  <p class="mono pie">
    <Icono nombre="calendario" tam="0.9em" />
    <time datetime={articulo.data.fecha.toISOString()}>{fecha}</time>
    {
      articulo.data.borrador && (
        <span class="borrador">
          <Icono nombre="alerta" tam="0.9em" /> Borrador
        </span>
      )
    }
  </p>
</article>

<style>
  .cabecera-tarjeta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .kicker {
    font-size: 0.6875rem;
    color: var(--acento, var(--neon));
    letter-spacing: 0.14em;
  }

  .tarjeta--grande {
    border-color: color-mix(in srgb, var(--acento, var(--neon)) 35%, var(--borde));
    padding: clamp(1.6rem, 3.5vw, 2.2rem);
  }

  .titulo {
    font-family: var(--f-ui);
    font-weight: 700;
    font-size: 1.25rem;
    line-height: 1.25;
    letter-spacing: -0.01em;
    margin-block: 0.8rem 0.5rem;
  }

  .tarjeta--grande .titulo {
    font-family: var(--f-titular);
    font-weight: 800;
    font-size: clamp(1.6rem, 3.4vw, 2.25rem);
    line-height: 1.12;
    margin-block: 1rem 0.75rem;
  }

  .titulo a {
    color: var(--texto);
    text-decoration: none;
  }

  .titulo a:hover {
    color: var(--acento, var(--neon));
  }

  /* El enlace del título cubre toda la tarjeta: área de clic más grande en móvil */
  .titulo a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .tarjeta {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .bajada {
    color: var(--texto-2);
    font-size: 0.95rem;
    flex: 1;
  }

  .tarjeta--grande .bajada {
    font-size: clamp(1.02rem, 1.8vw, 1.12rem);
    line-height: 1.55;
    max-width: 60ch;
  }

  .pie {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4em;
    margin-block-start: 1rem;
  }

  .borrador {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    margin-inline-start: 0.4em;
    color: var(--ambar);
  }
</style>
