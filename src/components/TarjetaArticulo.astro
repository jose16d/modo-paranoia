---
import type { CollectionEntry } from 'astro:content';
import { SECCIONES } from '../lib/secciones';

interface Props {
  articulo: CollectionEntry<'articulos'>;
  /** La pieza destacada de la portada se muestra más grande */
  grande?: boolean;
}

const { articulo, grande = false } = Astro.props;
const seccion = SECCIONES[articulo.data.seccion];

const fecha = articulo.data.fecha.toLocaleDateString('es-CO', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
});
---

<article class:list={['tarjeta', { 'tarjeta--grande': grande }]} style={`--acento: var(${seccion.color})`}>
  <span class="etiqueta">{seccion.nombre}</span>

  <h3 class="titulo">
    <a href={`/articulos/${articulo.id}`}>{articulo.data.titulo}</a>
  </h3>

  <p class="bajada">{articulo.data.bajada}</p>

  <p class="mono pie">
    <time datetime={articulo.data.fecha.toISOString()}>{fecha}</time>
    {articulo.data.borrador && <span class="borrador">· Borrador</span>}
  </p>
</article>

<style>
  .titulo {
    font-family: var(--f-ui);
    font-weight: 700;
    font-size: 1.25rem;
    line-height: 1.25;
    letter-spacing: -0.01em;
    margin-block: 0.8rem 0.5rem;
  }

  .tarjeta--grande .titulo {
    font-family: var(--f-titular);
    font-weight: 800;
    font-size: clamp(1.5rem, 3.2vw, 2rem);
    line-height: 1.12;
  }

  .titulo a {
    color: var(--texto);
    text-decoration: none;
  }

  .titulo a:hover {
    color: var(--acento, var(--neon));
  }

  /* El enlace del título cubre toda la tarjeta: área de clic más grande en móvil */
  .titulo a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .tarjeta {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .bajada {
    color: var(--texto-2);
    font-size: 0.95rem;
    flex: 1;
  }

  .pie {
    margin-block-start: 1rem;
  }

  .borrador {
    color: var(--ambar);
  }
</style>
