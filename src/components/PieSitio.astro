---
import Icono from './Icono.astro';
import { SECCIONES, CLAVES_SECCION, SITIO } from '../lib/secciones';

const anio = new Date().getFullYear();

/** `icono` es el nombre del archivo en docs/assets/iconos/, sin extensión. */
const legales = [
  { href: '/metodologia', texto: 'Metodología', icono: 'lupa-documento' },
  { href: '/politica-editorial', texto: 'Política editorial', icono: 'balanza' },
  { href: '/privacidad', texto: 'Privacidad', icono: 'escudo' },
  { href: '/cookies', texto: 'Cookies', icono: 'ojo' },
  { href: '/contacto', texto: 'Contacto', icono: 'correo' },
];
---

<footer class="pie">
  <div class="contenedor rejilla">
    <div>
      <p class="marca">MODO<span class="acento">PARANOIA</span></p>
      <p class="eslogan">{SITIO.eslogan}</p>
    </div>

    <nav aria-label="Secciones">
      <h2 class="mono titulo">Secciones</h2>
      <ul>
        {
          CLAVES_SECCION.map((clave) => (
            <li>
              <a href={`/seccion/${clave}`}>
                <Icono nombre={clave} familia="secciones" tam="1em" />
                {SECCIONES[clave].nombre}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-label="El medio">
      <h2 class="mono titulo">El medio</h2>
      <ul>
        <li>
          <a href="/quien-escribe">
            <Icono nombre="autor" tam="1em" />
            Quién escribe
          </a>
        </li>
        {
          legales.map((l) => (
            <li>
              <a href={l.href}>
                <Icono nombre={l.icono} tam="1em" />
                {l.texto}
              </a>
            </li>
          ))
        }
        <li>
          <a href="/etiquetas">
            <Icono nombre="etiqueta" tam="1em" />
            Etiquetas
          </a>
        </li>
        <li>
          <a href="/rss.xml">
            <Icono nombre="rss" tam="1em" />
            RSS
          </a>
        </li>
      </ul>
    </nav>
  </div>

  <div class="contenedor linea">
    <p class="mono">© {anio} {SITIO.nombre} · Los artículos no son de dominio público</p>
    <p class="mono">Hecho en Colombia</p>
  </div>
</footer>

<style>
  .pie {
    border-block-start: 1px solid var(--borde);
    margin-block-start: 5rem;
    padding-block: 3rem 2rem;
  }

  .rejilla {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2.5rem;
  }

  .marca {
    font-family: var(--f-titular);
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: -0.03em;
  }

  .acento { color: var(--neon); }

  .eslogan {
    color: var(--texto-2);
    font-size: 0.9rem;
    margin-block-start: 0.4rem;
    max-width: 28ch;
  }

  .titulo {
    font-size: 0.6875rem;
    margin-block-end: 0.8rem;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.45rem;
  }

  ul a {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    color: var(--texto-2);
    font-size: 0.9rem;
    text-decoration: none;
  }

  ul a:hover { color: var(--neon); }

  .linea {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    margin-block-start: 2.5rem;
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--borde);
  }
</style>
